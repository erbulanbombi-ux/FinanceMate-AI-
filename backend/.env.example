# Copy to .env and add your server-side credentials.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# For direct OpenAI, use AI_PROVIDER=openai and OPENAI_API_KEY instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8001
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
EMAIL_VERIFICATION_URL=http://127.0.0.1:5173/verify-email
PASSWORD_RESET_URL=http://127.0.0.1:5173/reset-password
SESSION_COOKIE_SECURE=false
AWS_REGION=us-east-1
